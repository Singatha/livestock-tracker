# Copy to .env.production and replace every value marked "change-me".
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

DJANGO_SECRET_KEY=change-me-use-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_ATTACHMENT_MAX_SIZE=10485760

POSTGRES_DB=livestock_tracker
POSTGRES_USER=livestock
POSTGRES_PASSWORD=change-me-use-a-strong-database-password

NUXT_PUBLIC_API_BASE=/api/v1
FRONTEND_BASE_URL=http://localhost

# The console backend writes email links to container logs. Configure SMTP if needed.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Flockwise <noreply@localhost>
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# Set these to true only when SITE_ADDRESS and the public URLs use HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
