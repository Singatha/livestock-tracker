# Public endpoint. DNS must point to the cloud host or load balancer.
SITE_ADDRESS=flockwise.example.com
DJANGO_ALLOWED_HOSTS=flockwise.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://flockwise.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://flockwise.example.com
FRONTEND_BASE_URL=https://flockwise.example.com
NUXT_PUBLIC_API_BASE=/api/v1

# Use immutable registry tags or, preferably, image digests.
API_IMAGE=ghcr.io/your-account/flockwise-api:replace-me
WEB_IMAGE=ghcr.io/your-account/flockwise-web:replace-me

# Inject secrets through the cloud platform or a host-only environment file.
DJANGO_SECRET_KEY=change-me
POSTGRES_DB=livestock_tracker
POSTGRES_USER=livestock
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=managed-postgres.example.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60
CELERY_BROKER_URL=rediss://default:change-me@managed-redis.example.com:6379/0?ssl_cert_reqs=required
DJANGO_CACHE_URL=rediss://default:change-me@managed-redis.example.com:6379/1?ssl_cert_reqs=required
DJANGO_NUM_PROXIES=1

# Abuse-protection limits. Keep the unit explicit: second, minute, hour, or day.
DJANGO_THROTTLE_LOGIN_RATE=10/min
DJANGO_THROTTLE_SIGNUP_RATE=5/hour
DJANGO_THROTTLE_PASSWORD_RESET_RATE=5/hour
DJANGO_THROTTLE_PASSWORD_RESET_CONFIRM_RATE=10/hour
DJANGO_THROTTLE_FARM_INVITATION_RATE=20/hour

# Private object storage. Prefer an instance/task role over static access keys.
DJANGO_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=flockwise-private
AWS_S3_REGION_NAME=af-south-1
AWS_S3_ENDPOINT_URL=
# Leave these empty when the workload receives an instance/task identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# HTTPS security settings.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ATTACHMENT_MAX_SIZE=10485760
DJANGO_LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO

# Optional error reporting. Leave SENTRY_DSN empty to disable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0

# Configure and verify a transactional email provider. See docs/email-delivery.md.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Flockwise <noreply@example.com>
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
